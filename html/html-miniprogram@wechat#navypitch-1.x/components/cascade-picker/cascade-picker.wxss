:host {
  display: block;
  --primary-color: #1677ff;
  --text-main: #1f2329;
  --text-regular: #4e5969;
  --text-placeholder: #c8c9cc;
  --border-color: #f2f3f5;
  --bg-hover: #f7f8fa;
}

/* ================= 默认 Trigger Box 样式 ================= */
.cascade-trigger-wrapper {
  width: 100%;
}

.cascade-default-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.cascade-trigger--disabled {
  opacity: 0.6;
  pointer-events: none;
}

.cascade-trigger__label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-right: 24rpx;
  min-width: 120rpx;
}

.cascade-trigger__content {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cascade-trigger__text--placeholder {
  color: var(--text-placeholder);
}

.cascade-trigger__text--filled {
  color: var(--text-main);
}

.cascade-trigger__arrow {
  color: #bbb;
  font-size: 32rpx;
  margin-left: 12rpx;
  line-height: 1;
}

/* ================= 弹层与抽屉 Sheet 样式 ================= */
.cascade-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(2px);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.28s ease, visibility 0.28s ease;
}
.cascade-mask--visible {
  opacity: 1;
  visibility: visible;
}

.cascade-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 68vh;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.08);
}
.cascade-sheet--visible {
  transform: translateY(0);
}

.cascade-sheet__header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.cascade-sheet__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.cascade-sheet__close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 16rpx;
  color: #8a8a8a;
  font-size: 32rpx;
}

/* Tab 栏 */
.cascade-tabs {
  display: flex;
  white-space: nowrap;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.cascade-tab-item {
  display: inline-flex;
  position: relative;
  align-items: center;
  height: 80rpx;
  margin-right: 48rpx;
  font-size: 28rpx;
  color: var(--text-regular);
}
.cascade-tab-item--active {
  color: var(--primary-color);
  font-weight: 500;
}
.cascade-tab-line {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

/* 列表选项 */
.cascade-list {
  flex: 1;
}
.cascade-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 36rpx;
  font-size: 28rpx;
  color: var(--text-main);
}
.cascade-cell--hover {
  background-color: var(--bg-hover);
}
.cascade-cell--active {
  color: var(--primary-color);
  font-weight: 500;
}
.cascade-cell__check {
  color: var(--primary-color);
  font-weight: bold;
}

.cascade-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.cascade-state__text {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 16rpx;
}
.cascade-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}