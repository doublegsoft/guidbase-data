page {
  height: 100%;
  background-color: #f8fafc;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 消息列表区 */
.chat-messages {
  flex: 1;
  padding: 30rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.message-wrap {
  display: flex;
  margin-bottom: 30rpx;
  gap: 16rpx;
}

/* 头像 */
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-content {
  display: flex;
  flex-direction: column;
  max-width: 70%;
}

/* 对方发出的消息靠左 */
.incoming {
  align-self: flex-start;
}

.incoming .bubble {
  background-color: #ffffff;
  color: #1f2937;
  border-radius: 30rpx 30rpx 30rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.incoming .time {
  align-self: flex-start;
}

/* 我发出的消息靠右 */
.outgoing {
  justify-content: flex-end;
}

.outgoing .bubble {
  background-color: #4f46e5;
  color: #ffffff;
  border-radius: 30rpx 30rpx 8rpx 30rpx;
}

.outgoing .time {
  align-self: flex-end;
}

.bubble {
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}

.time {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 底部输入框区 */
.chat-input-area {
  padding: 20rpx 24rpx env(safe-area-inset-bottom); /* 适配iPhone底部小黑条 */
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-box {
  flex: 1;
  background: #f1f5f9;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
}

.input-box input {
  font-size: 28rpx;
  color: #1f2937;
  height: 40rpx;
  line-height: 40rpx;
}

.send-btn {
  background-color: #4f46e5 !important;
  color: #ffffff !important;
  font-size: 26rpx !important;
  padding: 0 32rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  border-radius: 36rpx !important;
  margin: 0 !important;
  font-weight: 500;
}

.send-btn:active {
  opacity: 0.85;
}